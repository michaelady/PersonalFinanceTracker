rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Personal ledger: only the signed-in user may read/write their tree.
    // Path used by the app: users/{uid}/data/snapshot
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Household invite docs. Unsigned-in users share via unguessable
    // document ids + inviteKey (`?hh=<id>&k=<inviteKey>`).
    match /households/{householdId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['inviteKey', 'snapshot', 'updatedAt'])
                    && request.resource.data.inviteKey is string
                    && request.resource.data.inviteKey.size() >= 8;
      allow update: if request.resource.data.inviteKey == resource.data.inviteKey;
      allow delete: if true;
    }
  }
}
