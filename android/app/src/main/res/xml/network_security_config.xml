<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release traffic is HTTPS only (FX, quotes, Firebase, OAuth). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
